{
  "datasets": [
    {
      "name": "sales_gold",
      "displayName": "Gold Sales & Supply Chain",
      "config": {
        "source": "dev.gold.fact_sales",
        "measures": [
          {
            "name": "net_revenue",
            "expr": "SUM(net_revenue)",
            "comment": "Net revenue before tax, extended price times (1 - discount)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT order_key)",
            "comment": "Count of distinct orders"
          },
          {
            "name": "active_customers",
            "expr": "COUNT(DISTINCT customer_key)",
            "comment": "Customers with at least one order in the period"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(net_revenue) / COUNT(DISTINCT order_key)",
            "comment": "Net revenue divided by distinct orders",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "avg_discount_rate",
            "expr": "AVG(discount_rate)",
            "comment": "Average line discount rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "avg_ship_days",
            "expr": "AVG(DATEDIFF(receipt_date, ship_date))",
            "comment": "Average days from ship date to receipt date",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ],
        "version": "1.1",
        "comment": "Sales and supply chain KPIs built on the Gold fact_sales table (one row per order line)",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "order_date",
            "comment": "Date the order was placed",
            "format": {
              "type": "date",
              "dateFormat": "year_month_day"
            }
          },
          {
            "name": "customer_name",
            "expr": "customer_name",
            "comment": "Customer name"
          },
          {
            "name": "customer_market_segment",
            "expr": "customer_market_segment",
            "comment": "Customer market segment"
          },
          {
            "name": "customer_region_name",
            "expr": "customer_region_name",
            "comment": "Customer region"
          },
          {
            "name": "customer_nation_name",
            "expr": "customer_nation_name",
            "comment": "Customer nation"
          },
          {
            "name": "product_name",
            "expr": "product_name",
            "comment": "Product name"
          },
          {
            "name": "supplier_name",
            "expr": "supplier_name",
            "comment": "Supplier name"
          },
          {
            "name": "supplier_nation_name",
            "expr": "supplier_nation_name",
            "comment": "Supplier nation"
          },
          {
            "name": "supplier_region_name",
            "expr": "supplier_region_name",
            "comment": "Supplier region"
          },
          {
            "name": "ship_mode",
            "expr": "ship_mode",
            "comment": "Shipping mode"
          }
        ]
      }
    }
  ],
